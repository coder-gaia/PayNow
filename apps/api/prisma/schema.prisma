// Schema do Paynow.
//
// Convencoes:
//
//   - identificadores sao UUID v7, ordenaveis por tempo, o que da localidade de
//     indice sem expor sequencia previsivel na API publica;
//   - o banco usa snake_case e o cliente camelCase, via @map;
//   - todo instante e timestamptz com precisao de milissegundo;
//   - createdAt e updatedAt vem do relogio do banco de proposito: registram
//     quando a linha foi escrita, que e fato de infraestrutura. Tempo de
//     dominio vem do Clock injetado (ADR-0009).
//
// Ver docs/plano-de-contas.md para o contrato contabil que a fase 02 implementa.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identidade (fase 01)
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique @db.Citext
  passwordHash    String    @map("password_hash")
  name            String
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships   Membership[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships    Membership[]
  apiKeys        ApiKey[]
  accounts       Account[]
  journalEntries JournalEntry[]
  customers      Customer[]
  products       Product[]
  subscriptions  Subscription[]
  invoices       Invoice[]
  payments       Payment[]
  clock          OrganizationClock?

  @@map("organizations")
}

/// Relogio da organizacao. Ver ADR-0015.
///
/// A ausencia de linha significa relogio de parede, que e o caso comum: so
/// quem congelou o tempo tem registro aqui. Guardar o instante congelado em
/// vez de um deslocamento e deliberado, porque deslocamento continua andando
/// e o objetivo e o oposto: o tempo so muda quando alguem manda mudar.
model OrganizationClock {
  organizationId String   @id @map("organization_id") @db.Uuid
  frozenAt       DateTime @map("frozen_at") @db.Timestamptz(3)
  /// Instante em que o relogio foi congelado, para mostrar o quanto ja avancou.
  startedAt      DateTime @map("started_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_clocks")
}

/// Papeis em ordem decrescente de poder. A comparacao e feita por hierarquia
/// numerica no codigo, e nao por lista de permissoes, porque com quatro papeis
/// estritamente ordenados uma matriz de permissoes so adicionaria cerimonia.
///
/// Os comentarios deste arquivo ficam sem acento de proposito: o Prisma os
/// copia para o cliente gerado, e a geracao normaliza a codificacao de um
/// jeito que corrompe caractere acentuado no Windows. Todo texto que chega a
/// uma pessoa vive no codigo da aplicacao, acentuado.
enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  READONLY

  @@map("organization_role")
}

model Membership {
  id             String           @id @default(uuid(7)) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  role           OrganizationRole
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

/// Motivo pelo qual um refresh token deixou de valer. Guardar o motivo, e nao
/// apenas apagar a linha, e o que permite investigar um roubo de token depois.
enum RefreshTokenRevocationReason {
  ROTATED
  REUSE_DETECTED
  LOGOUT

  @@map("refresh_token_revocation_reason")
}

/// Refresh token com rotacao e deteccao de reuso.
///
/// Cada login abre uma familia. Cada uso rotaciona o token e marca o anterior
/// como consumido. Apresentar um token ja consumido significa que ele vazou,
/// e a familia inteira e revogada.
///
/// O valor nao e armazenado, apenas o hash. Ver a nota sobre SHA-256 em
/// token-hasher.ts: o segredo aqui tem entropia alta, entao o custo do argon2
/// nao se justifica.
model RefreshToken {
  id            String                        @id @default(uuid(7)) @db.Uuid
  userId        String                        @map("user_id") @db.Uuid
  familyId      String                        @map("family_id") @db.Uuid
  tokenHash     String                        @unique @map("token_hash")
  expiresAt     DateTime                      @map("expires_at") @db.Timestamptz(3)
  consumedAt    DateTime?                     @map("consumed_at") @db.Timestamptz(3)
  revokedAt     DateTime?                     @map("revoked_at") @db.Timestamptz(3)
  revokedReason RefreshTokenRevocationReason? @map("revoked_reason")
  userAgent     String?                       @map("user_agent")
  createdAt     DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

enum ApiKeyEnvironment {
  TEST
  LIVE

  @@map("api_key_environment")
}

/// Chave de API do merchant.
///
/// O segredo completo e mostrado uma unica vez, na criacao. O que fica gravado
/// e o prefixo, que serve para busca e para exibicao na interface, e o hash do
/// segredo inteiro.
model ApiKey {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  name           String
  environment    ApiKeyEnvironment
  prefix         String            @unique
  tokenHash      String            @unique @map("token_hash")
  lastUsedAt     DateTime?         @map("last_used_at") @db.Timestamptz(3)
  revokedAt      DateTime?         @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("api_keys")
}

// ---------------------------------------------------------------------------
// Ledger (fase 02)
//
// Ver docs/plano-de-contas.md para o contrato contabil e docs/adr/0003 para a
// decisao. Tres regras nao vivem aqui, e sim no SQL da migration, porque o
// Prisma nao as expressa e elas precisam valer para qualquer caminho que
// escreva no banco, inclusive um psql aberto por engano:
//
//   1. todo lancamento soma zero por moeda, verificado no commit;
//   2. lancamento e linha nao aceitam UPDATE nem DELETE;
//   3. linha com valor zero e recusada.
// ---------------------------------------------------------------------------

/// Natureza contabil da conta. Define de que lado fica o saldo normal e como o
/// valor entra no balancete.
enum AccountKind {
  ASSET
  LIABILITY
  REVENUE
  CONTRA_REVENUE

  @@map("account_kind")
}

/// Conta do razao, escopada por organizacao.
///
/// Contas nascem sob demanda, no primeiro lancamento que as usa. Provisionar
/// na criacao da organizacao exigiria que o modulo de identidade conhecesse o
/// ledger, e a ADR-0001 proibe modulo de dominio importar modulo de dominio.
model Account {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  code           String
  kind           AccountKind
  currency       String      @db.Char(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lines        JournalLine[]

  @@unique([organizationId, code, currency])
  @@index([organizationId])
  @@map("accounts")
}

/// Lancamento contabil: um evento de dominio e suas linhas balanceadas.
///
/// A chave unica sobre o evento e idempotencia no nivel do banco. Reprocessar o
/// mesmo webhook nao duplica lancamento nem quando a camada de aplicacao falha
/// em perceber a repeticao.
model JournalEntry {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  eventType      String   @map("event_type")
  eventId        String   @map("event_id")
  description    String
  /// Quando o fato aconteceu, vindo do relogio injetado (ADR-0009).
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(3)
  /// Quando a linha foi gravada, vindo do relogio do banco.
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lines        JournalLine[]

  @@unique([organizationId, eventType, eventId])
  @@index([organizationId, occurredAt])
  @@map("journal_entries")
}

/// Uma perna do lancamento.
///
/// Convencao de sinal unico: positivo e debito, negativo e credito. Isso
/// substitui duas colunas por uma e transforma "debitos igualam creditos" na
/// verificacao mais simples possivel, que e somar e comparar com zero.
model JournalLine {
  id          String   @id @default(uuid(7)) @db.Uuid
  entryId     String   @map("entry_id") @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  amountMinor BigInt   @map("amount_minor")
  currency    String   @db.Char(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  account Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([accountId])
  @@map("journal_lines")
}

// ---------------------------------------------------------------------------
// Catálogo e assinaturas (fase 03)
// ---------------------------------------------------------------------------

/// Cliente do merchant.
///
/// Não confundir com `User`, que é quem opera o painel do Paynow. Este é quem
/// paga a assinatura do merchant, e nunca tem acesso ao sistema.
model Customer {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Identificador do cliente no sistema do merchant, quando existir.
  externalId     String?  @map("external_id")
  email          String   @db.Citext
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Token opaco do meio de pagamento, emitido pelo provedor.
  ///
  /// Nunca guardamos numero de cartao. O que fica aqui e uma referencia que so
  /// o provedor sabe resolver, e bandeira e ultimos quatro digitos para
  /// exibicao. Ver ADR-0014: e isto que mantem o escopo PCI em SAQ-A.
  paymentMethodToken String? @map("payment_method_token")
  paymentMethodBrand String? @map("payment_method_brand")
  paymentMethodLast4 String? @map("payment_method_last4") @db.VarChar(4)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]
  invoices      Invoice[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("customers")
}

/// Situacao de uma fatura.
enum InvoiceStatus {
  /// Emitida e ainda nao paga.
  OPEN
  /// Quitada.
  PAID
  /// Anulada antes de ser paga. Nao vira receita.
  VOID
  /// Recuperacao esgotada sem pagamento.
  UNCOLLECTIBLE
}

/// O que o cliente deve por um periodo.
///
/// A fatura existe para que pagamento tenha objeto. Sem ela, "pagar" nao teria
/// o que quitar, e a recuperacao nao teria onde contar tentativas.
model Invoice {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  customerId     String        @map("customer_id") @db.Uuid
  subscriptionId String?       @map("subscription_id") @db.Uuid
  /// Sequencial por organizacao, para leitura humana. Ver InvoicesService.
  number         Int
  status         InvoiceStatus

  amountMinor BigInt @map("amount_minor")
  currency    String @db.Char(3)

  periodStart DateTime  @map("period_start") @db.Timestamptz(3)
  periodEnd   DateTime  @map("period_end") @db.Timestamptz(3)
  dueAt       DateTime  @map("due_at") @db.Timestamptz(3)
  paidAt      DateTime? @map("paid_at") @db.Timestamptz(3)

  /// Quantas cobrancas ja foram tentadas, e quando vem a proxima.
  attemptCount  Int       @default(0) @map("attempt_count")
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(3)

  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  payments     Payment[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([nextAttemptAt])
  @@map("invoices")
}

/// Resultado de uma tentativa de cobranca.
enum PaymentStatus {
  /// Enviada e sem resposta. O provedor pode ou nao ter cobrado.
  PENDING
  SUCCEEDED
  FAILED
}

/// Uma tentativa de cobranca contra uma fatura.
///
/// Cada tentativa e uma linha, e nenhuma e apagada. O historico de tentativas
/// e o que responde "por que este cliente foi cortado", e sobrescrever a
/// tentativa anterior apagaria justamente a resposta.
model Payment {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  invoiceId      String        @map("invoice_id") @db.Uuid
  /// Numero da tentativa, a partir de 1.
  attempt        Int
  status         PaymentStatus

  amountMinor BigInt @map("amount_minor")
  currency    String @db.Char(3)

  gateway    String
  gatewayRef String? @map("gateway_ref")

  failureCode    String?  @map("failure_code")
  failureMessage String?  @map("failure_message")
  retriable      Boolean?

  /// Chave enviada ao provedor. Deriva da fatura e da tentativa, nunca aleatoria.
  idempotencyKey String @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, attempt])
  @@index([organizationId, status])
  @@map("payments")
}

/// O que o merchant vende. "Plano Pro", por exemplo.
model Product {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  prices       Price[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("products")
}

enum BillingInterval {
  DAY
  WEEK
  MONTH
  YEAR

  @@map("billing_interval")
}

/// Quanto custa e de quanto em quanto tempo.
///
/// Preço é imutável depois de ter assinatura: mudar o valor de um preço em uso
/// reescreveria silenciosamente o que já foi cobrado. Para mudar de valor,
/// cria-se um preço novo e migram-se as assinaturas, que é o que a troca de
/// plano faz.
model Price {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  productId      String          @map("product_id") @db.Uuid
  amountMinor    BigInt          @map("amount_minor")
  currency       String          @db.Char(3)
  interval       BillingInterval
  intervalCount  Int             @default(1) @map("interval_count")
  trialDays      Int             @default(0) @map("trial_days")
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]

  @@index([organizationId])
  @@index([productId])
  @@map("prices")
}

/// Estados possíveis de uma assinatura.
///
/// A máquina de estados é explícita, e as transições válidas vivem em
/// domain/subscription-state.ts. Um campo de texto livre com "status" deixaria
/// qualquer transição passar.
enum SubscriptionStatus {
  /// Criada, esperando o primeiro pagamento confirmar.
  INCOMPLETE
  /// Em período de teste, ainda sem cobrança.
  TRIALING
  /// Em dia.
  ACTIVE
  /// Cobrança falhou e a recuperação está em andamento.
  PAST_DUE
  /// Encerrada, por pedido ou por esgotamento da recuperação.
  CANCELED
  /// Recuperação esgotada sem sucesso.
  UNPAID

  @@map("subscription_status")
}

model Subscription {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  customerId     String             @map("customer_id") @db.Uuid
  priceId        String             @map("price_id") @db.Uuid
  status         SubscriptionStatus

  currentPeriodStart DateTime  @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd   DateTime  @map("current_period_end") @db.Timestamptz(3)
  trialEndsAt        DateTime? @map("trial_ends_at") @db.Timestamptz(3)
  /// Cancelamento pedido para o fim do ciclo, ainda não efetivado.
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt         DateTime? @map("canceled_at") @db.Timestamptz(3)

  /// Versão para concorrência otimista. Ver ADR-0008.
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  price        Price               @relation(fields: [priceId], references: [id], onDelete: Restrict)
  events       SubscriptionEvent[]
  invoices     Invoice[]

  @@index([organizationId, status])
  @@index([customerId])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

/// Histórico de tudo que aconteceu com uma assinatura.
///
/// Append-only pelo mesmo motivo do razão: a trilha do que mudou vale tanto
/// quanto o estado atual, e é ela que responde "por que esta assinatura está
/// assim". Alimenta a fatura explicável da fase 08.
model SubscriptionEvent {
  id             String              @id @default(uuid(7)) @db.Uuid
  subscriptionId String              @map("subscription_id") @db.Uuid
  fromStatus     SubscriptionStatus? @map("from_status")
  toStatus       SubscriptionStatus  @map("to_status")
  reason         String
  occurredAt     DateTime            @map("occurred_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([subscriptionId, occurredAt])
  @@map("subscription_events")
}
