// Schema do Paynow.
//
// Convencoes:
//
//   - identificadores sao UUID v7, ordenaveis por tempo, o que da localidade de
//     indice sem expor sequencia previsivel na API publica;
//   - o banco usa snake_case e o cliente camelCase, via @map;
//   - todo instante e timestamptz com precisao de milissegundo;
//   - createdAt e updatedAt vem do relogio do banco de proposito: registram
//     quando a linha foi escrita, que e fato de infraestrutura. Tempo de
//     dominio vem do Clock injetado (ADR-0009).
//
// Ver docs/plano-de-contas.md para o contrato contabil que a fase 02 implementa.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identidade (fase 01)
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique @db.Citext
  passwordHash    String    @map("password_hash")
  name            String
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships   Membership[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships       Membership[]
  apiKeys           ApiKey[]
  accounts          Account[]
  journalEntries    JournalEntry[]
  customers         Customer[]
  products          Product[]
  subscriptions     Subscription[]
  invoices          Invoice[]
  payments          Payment[]
  refunds           Refund[]
  outbox            OutboxMessage[]
  webhookEndpoints  WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]
  clock             OrganizationClock?

  @@map("organizations")
}

/// Relogio da organizacao. Ver ADR-0015.
///
/// A ausencia de linha significa relogio de parede, que e o caso comum: so
/// quem congelou o tempo tem registro aqui. Guardar o instante congelado em
/// vez de um deslocamento e deliberado, porque deslocamento continua andando
/// e o objetivo e o oposto: o tempo so muda quando alguem manda mudar.
model OrganizationClock {
  organizationId String   @id @map("organization_id") @db.Uuid
  frozenAt       DateTime @map("frozen_at") @db.Timestamptz(3)
  /// Instante em que o relogio foi congelado, para mostrar o quanto ja avancou.
  startedAt      DateTime @map("started_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_clocks")
}

/// Papeis em ordem decrescente de poder. A comparacao e feita por hierarquia
/// numerica no codigo, e nao por lista de permissoes, porque com quatro papeis
/// estritamente ordenados uma matriz de permissoes so adicionaria cerimonia.
///
/// Os comentarios deste arquivo ficam sem acento de proposito: o Prisma os
/// copia para o cliente gerado, e a geracao normaliza a codificacao de um
/// jeito que corrompe caractere acentuado no Windows. Todo texto que chega a
/// uma pessoa vive no codigo da aplicacao, acentuado.
enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  READONLY

  @@map("organization_role")
}

model Membership {
  id             String           @id @default(uuid(7)) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  role           OrganizationRole
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

/// Motivo pelo qual um refresh token deixou de valer. Guardar o motivo, e nao
/// apenas apagar a linha, e o que permite investigar um roubo de token depois.
enum RefreshTokenRevocationReason {
  ROTATED
  REUSE_DETECTED
  LOGOUT

  @@map("refresh_token_revocation_reason")
}

/// Refresh token com rotacao e deteccao de reuso.
///
/// Cada login abre uma familia. Cada uso rotaciona o token e marca o anterior
/// como consumido. Apresentar um token ja consumido significa que ele vazou,
/// e a familia inteira e revogada.
///
/// O valor nao e armazenado, apenas o hash. Ver a nota sobre SHA-256 em
/// token-hasher.ts: o segredo aqui tem entropia alta, entao o custo do argon2
/// nao se justifica.
model RefreshToken {
  id            String                        @id @default(uuid(7)) @db.Uuid
  userId        String                        @map("user_id") @db.Uuid
  familyId      String                        @map("family_id") @db.Uuid
  tokenHash     String                        @unique @map("token_hash")
  expiresAt     DateTime                      @map("expires_at") @db.Timestamptz(3)
  consumedAt    DateTime?                     @map("consumed_at") @db.Timestamptz(3)
  revokedAt     DateTime?                     @map("revoked_at") @db.Timestamptz(3)
  revokedReason RefreshTokenRevocationReason? @map("revoked_reason")
  userAgent     String?                       @map("user_agent")
  createdAt     DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

enum ApiKeyEnvironment {
  TEST
  LIVE

  @@map("api_key_environment")
}

/// Chave de API do merchant.
///
/// O segredo completo e mostrado uma unica vez, na criacao. O que fica gravado
/// e o prefixo, que serve para busca e para exibicao na interface, e o hash do
/// segredo inteiro.
model ApiKey {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  name           String
  environment    ApiKeyEnvironment
  prefix         String            @unique
  tokenHash      String            @unique @map("token_hash")
  lastUsedAt     DateTime?         @map("last_used_at") @db.Timestamptz(3)
  revokedAt      DateTime?         @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("api_keys")
}

// ---------------------------------------------------------------------------
// Ledger (fase 02)
//
// Ver docs/plano-de-contas.md para o contrato contabil e docs/adr/0003 para a
// decisao. Tres regras nao vivem aqui, e sim no SQL da migration, porque o
// Prisma nao as expressa e elas precisam valer para qualquer caminho que
// escreva no banco, inclusive um psql aberto por engano:
//
//   1. todo lancamento soma zero por moeda, verificado no commit;
//   2. lancamento e linha nao aceitam UPDATE nem DELETE;
//   3. linha com valor zero e recusada.
// ---------------------------------------------------------------------------

/// Natureza contabil da conta. Define de que lado fica o saldo normal e como o
/// valor entra no balancete.
enum AccountKind {
  ASSET
  LIABILITY
  REVENUE
  CONTRA_REVENUE

  @@map("account_kind")
}

/// Conta do razao, escopada por organizacao.
///
/// Contas nascem sob demanda, no primeiro lancamento que as usa. Provisionar
/// na criacao da organizacao exigiria que o modulo de identidade conhecesse o
/// ledger, e a ADR-0001 proibe modulo de dominio importar modulo de dominio.
model Account {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  code           String
  kind           AccountKind
  currency       String      @db.Char(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lines        JournalLine[]

  @@unique([organizationId, code, currency])
  @@index([organizationId])
  @@map("accounts")
}

/// Lancamento contabil: um evento de dominio e suas linhas balanceadas.
///
/// A chave unica sobre o evento e idempotencia no nivel do banco. Reprocessar o
/// mesmo webhook nao duplica lancamento nem quando a camada de aplicacao falha
/// em perceber a repeticao.
model JournalEntry {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  eventType      String   @map("event_type")
  eventId        String   @map("event_id")
  description    String
  /// Quando o fato aconteceu, vindo do relogio injetado (ADR-0009).
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(3)
  /// Quando a linha foi gravada, vindo do relogio do banco.
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lines        JournalLine[]

  @@unique([organizationId, eventType, eventId])
  @@index([organizationId, occurredAt])
  @@map("journal_entries")
}

/// Uma perna do lancamento.
///
/// Convencao de sinal unico: positivo e debito, negativo e credito. Isso
/// substitui duas colunas por uma e transforma "debitos igualam creditos" na
/// verificacao mais simples possivel, que e somar e comparar com zero.
model JournalLine {
  id          String   @id @default(uuid(7)) @db.Uuid
  entryId     String   @map("entry_id") @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  amountMinor BigInt   @map("amount_minor")
  currency    String   @db.Char(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  account Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([accountId])
  @@map("journal_lines")
}

// ---------------------------------------------------------------------------
// Catálogo e assinaturas (fase 03)
// ---------------------------------------------------------------------------

/// Cliente do merchant.
///
/// Não confundir com `User`, que é quem opera o painel do Paynow. Este é quem
/// paga a assinatura do merchant, e nunca tem acesso ao sistema.
model Customer {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Identificador do cliente no sistema do merchant, quando existir.
  externalId     String?  @map("external_id")
  email          String   @db.Citext
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Token opaco do meio de pagamento, emitido pelo provedor.
  ///
  /// Nunca guardamos numero de cartao. O que fica aqui e uma referencia que so
  /// o provedor sabe resolver, e bandeira e ultimos quatro digitos para
  /// exibicao. Ver ADR-0014: e isto que mantem o escopo PCI em SAQ-A.
  paymentMethodToken String? @map("payment_method_token")
  paymentMethodBrand String? @map("payment_method_brand")
  paymentMethodLast4 String? @map("payment_method_last4") @db.VarChar(4)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]
  invoices      Invoice[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("customers")
}

/// Situacao de uma fatura.
enum InvoiceStatus {
  /// Emitida e ainda nao paga.
  OPEN
  /// Quitada.
  PAID
  /// Anulada antes de ser paga. Nao vira receita.
  VOID
  /// Recuperacao esgotada sem pagamento.
  UNCOLLECTIBLE
}

/// O que o cliente deve por um periodo.
///
/// A fatura existe para que pagamento tenha objeto. Sem ela, "pagar" nao teria
/// o que quitar, e a recuperacao nao teria onde contar tentativas.
model Invoice {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  customerId     String        @map("customer_id") @db.Uuid
  subscriptionId String?       @map("subscription_id") @db.Uuid
  /// Sequencial por organizacao, para leitura humana. Ver InvoicesService.
  number         Int
  status         InvoiceStatus

  amountMinor BigInt @map("amount_minor")
  currency    String @db.Char(3)

  periodStart DateTime  @map("period_start") @db.Timestamptz(3)
  periodEnd   DateTime  @map("period_end") @db.Timestamptz(3)
  dueAt       DateTime  @map("due_at") @db.Timestamptz(3)
  paidAt      DateTime? @map("paid_at") @db.Timestamptz(3)

  /// Quantas cobrancas ja foram tentadas, e quando vem a proxima.
  attemptCount  Int       @default(0) @map("attempt_count")
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(3)

  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  payments     Payment[]
  refunds      Refund[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([nextAttemptAt])
  @@map("invoices")
}

/// Resultado de uma tentativa de cobranca.
enum PaymentStatus {
  /// Enviada e sem resposta. O provedor pode ou nao ter cobrado.
  PENDING
  SUCCEEDED
  FAILED
}

/// Uma tentativa de cobranca contra uma fatura.
///
/// Cada tentativa e uma linha, e nenhuma e apagada. O historico de tentativas
/// e o que responde "por que este cliente foi cortado", e sobrescrever a
/// tentativa anterior apagaria justamente a resposta.
model Payment {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  invoiceId      String        @map("invoice_id") @db.Uuid
  /// Numero da tentativa, a partir de 1.
  attempt        Int
  status         PaymentStatus

  amountMinor BigInt @map("amount_minor")
  currency    String @db.Char(3)

  gateway    String
  gatewayRef String? @map("gateway_ref")

  failureCode    String?  @map("failure_code")
  failureMessage String?  @map("failure_message")
  retriable      Boolean?

  /// Chave enviada ao provedor. Deriva da fatura e da tentativa, nunca aleatoria.
  idempotencyKey String @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  refunds      Refund[]

  @@unique([invoiceId, attempt])
  /// A chave e o unico identificador que o provedor conhece: e o que mandamos
  /// a ele. O webhook de entrada casa a notificacao com a cobranca por ela, e
  /// esse caminho so e correto se a chave apontar para uma linha so. Ja era
  /// verdade por construcao, porque a chave deriva de (fatura, tentativa), mas
  /// verdade por construcao vira mentira quando alguem muda a construcao.
  @@unique([idempotencyKey])
  @@index([organizationId, status])
  @@map("payments")
}

/// O que o merchant vende. "Plano Pro", por exemplo.
model Product {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  prices       Price[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("products")
}

enum BillingInterval {
  DAY
  WEEK
  MONTH
  YEAR

  @@map("billing_interval")
}

/// Quanto custa e de quanto em quanto tempo.
///
/// Preço é imutável depois de ter assinatura: mudar o valor de um preço em uso
/// reescreveria silenciosamente o que já foi cobrado. Para mudar de valor,
/// cria-se um preço novo e migram-se as assinaturas, que é o que a troca de
/// plano faz.
model Price {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  productId      String          @map("product_id") @db.Uuid
  amountMinor    BigInt          @map("amount_minor")
  currency       String          @db.Char(3)
  interval       BillingInterval
  intervalCount  Int             @default(1) @map("interval_count")
  trialDays      Int             @default(0) @map("trial_days")
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]

  @@index([organizationId])
  @@index([productId])
  @@map("prices")
}

/// Estados possíveis de uma assinatura.
///
/// A máquina de estados é explícita, e as transições válidas vivem em
/// domain/subscription-state.ts. Um campo de texto livre com "status" deixaria
/// qualquer transição passar.
enum SubscriptionStatus {
  /// Criada, esperando o primeiro pagamento confirmar.
  INCOMPLETE
  /// Em período de teste, ainda sem cobrança.
  TRIALING
  /// Em dia.
  ACTIVE
  /// Cobrança falhou e a recuperação está em andamento.
  PAST_DUE
  /// Encerrada, por pedido ou por esgotamento da recuperação.
  CANCELED
  /// Recuperação esgotada sem sucesso.
  UNPAID

  @@map("subscription_status")
}

model Subscription {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  customerId     String             @map("customer_id") @db.Uuid
  priceId        String             @map("price_id") @db.Uuid
  status         SubscriptionStatus

  currentPeriodStart DateTime  @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd   DateTime  @map("current_period_end") @db.Timestamptz(3)
  trialEndsAt        DateTime? @map("trial_ends_at") @db.Timestamptz(3)
  /// Cancelamento pedido para o fim do ciclo, ainda não efetivado.
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt         DateTime? @map("canceled_at") @db.Timestamptz(3)

  /// Versão para concorrência otimista. Ver ADR-0008.
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  price        Price               @relation(fields: [priceId], references: [id], onDelete: Restrict)
  events       SubscriptionEvent[]
  invoices     Invoice[]

  @@index([organizationId, status])
  @@index([customerId])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

/// Histórico de tudo que aconteceu com uma assinatura.
///
/// Append-only pelo mesmo motivo do razão: a trilha do que mudou vale tanto
/// quanto o estado atual, e é ela que responde "por que esta assinatura está
/// assim". Alimenta a fatura explicável da fase 08.
model SubscriptionEvent {
  id             String              @id @default(uuid(7)) @db.Uuid
  subscriptionId String              @map("subscription_id") @db.Uuid
  fromStatus     SubscriptionStatus? @map("from_status")
  toStatus       SubscriptionStatus  @map("to_status")
  reason         String
  occurredAt     DateTime            @map("occurred_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([subscriptionId, occurredAt])
  @@map("subscription_events")
}

/// Estado de um registro de idempotencia.
enum IdempotencyStatus {
  /// A requisicao original ainda esta sendo processada.
  IN_PROGRESS
  /// Terminou, e a resposta esta guardada para repeticoes.
  COMPLETED
}

/// Resposta guardada por chave de idempotencia. Ver ADR-0007.
///
/// O escopo separa as chaves por cliente: uma chave escolhida por um merchant
/// nunca colide com a de outro, e nao ha como um adivinhar a chave do outro
/// para ler uma resposta alheia.
///
/// O hash da requisicao existe para pegar o erro mais comum de quem usa
/// idempotencia errado: reaproveitar a mesma chave para um pedido diferente.
/// Sem ele, a segunda chamada receberia calada a resposta da primeira, e o
/// cliente concluiria que cobrou quando nao cobrou.
model IdempotencyRecord {
  id    String @id @default(uuid(7)) @db.Uuid
  scope String
  key   String

  method      String
  path        String
  requestHash String @map("request_hash")

  status         IdempotencyStatus
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

/// Situacao de uma mensagem do outbox.
enum OutboxStatus {
  /// Esperando entrega.
  PENDING
  /// Entregue a todos os consumidores.
  DELIVERED
  /// Tentativas esgotadas. Fica para inspecao, nunca some sozinha.
  FAILED
}

/// Outbox transacional. Ver ADR-0006.
///
/// O evento e gravado aqui na mesma transacao que mudou o estado, e entregue
/// depois. E isso que impede as duas falhas classicas: publicar antes do commit
/// anuncia um fato que pode nao acontecer, e publicar depois perde o anuncio se
/// o processo morrer no meio.
///
/// O indice unico sobre (organizacao, tipo, evento) e o mesmo desenho do razao:
/// a chave vem do fato de dominio, nunca de um aleatorio, entao republicar o
/// mesmo fato nao cria segunda mensagem.
model OutboxMessage {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  eventType  String   @map("event_type")
  eventId    String   @map("event_id")
  payload    Json
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)

  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime?    @map("next_attempt_at") @db.Timestamptz(3)
  lastError     String?      @map("last_error")
  deliveredAt   DateTime?    @map("delivered_at") @db.Timestamptz(3)

  /// Quais consumidores ja receberam esta mensagem, por nome.
  ///
  /// Sem isto a garantia prometida em outbox.ts nao existe. Com uma lista de
  /// consumidores e uma retentativa unica para a mensagem inteira, so ha duas
  /// possibilidades, e as duas estao erradas: ou a rodada para no primeiro que
  /// falha, e os seguintes nunca recebem enquanto ele falhar, ou ela segue e a
  /// retentativa reentrega a quem ja tinha recebido, o que manda o mesmo email
  /// duas vezes.
  ///
  /// Com a lista, a retentativa cobre exatamente quem faltou.
  deliveredTo String[] @default([]) @map("delivered_to")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, eventType, eventId])
  @@index([status, nextAttemptAt])
  @@map("outbox_messages")
}

/// Situacao de um estorno.
enum RefundStatus {
  /// Enviado ao provedor, sem resposta.
  PENDING
  SUCCEEDED
  FAILED
}

/// Devolucao de dinheiro ja recebido.
///
/// O estorno nao apaga o pagamento: e um fato novo, com data propria, que
/// aponta para o pagamento que esta desfazendo. Anular o lancamento original
/// destruiria a resposta para "quanto entrou em marco", que continua sendo o
/// valor cheio mesmo depois de devolvido em abril.
model Refund {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  paymentId      String @map("payment_id") @db.Uuid
  invoiceId      String @map("invoice_id") @db.Uuid

  amountMinor BigInt @map("amount_minor")
  currency    String @db.Char(3)
  reason      String

  status         RefundStatus
  gatewayRef     String?      @map("gateway_ref")
  failureMessage String?      @map("failure_message")
  idempotencyKey String       @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([paymentId])
  @@map("refunds")
}

/// Endereco do merchant que recebe nossos eventos.
model WebhookEndpoint {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  url         String
  description String?

  /// Segredo usado para assinar. Guardado em claro porque assinar exige o
  /// valor, e nao o hash: diferente da chave de API, que so precisa ser
  /// comparada. Cifrar em repouso entra no endurecimento da fase 09, e ate la
  /// isto e divida consciente e nomeada.
  secret String

  enabled Boolean @default(true)

  /// Tipos de evento assinados. Lista vazia significa todos, que e o padrao
  /// util: quem integra costuma querer tudo antes de saber o que filtrar.
  eventTypes String[] @map("event_types")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  disabledAt DateTime? @map("disabled_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId, enabled])
  @@map("webhook_endpoints")
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  /// Tentativas esgotadas. Fica para inspecao e pode ser reenviada a mao.
  FAILED
}

/// Uma entrega, para um endereco, de um evento.
///
/// A linha existe antes de qualquer chamada HTTP acontecer, e e ela que torna a
/// entrega retentavel sem duplicar. O indice unico sobre (endereco, evento) e o
/// que permite o consumidor do outbox ser reexecutado a vontade: ele so cria
/// linhas, e criar a mesma duas vezes e recusado pelo banco.
model WebhookDelivery {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  endpointId     String @map("endpoint_id") @db.Uuid

  eventType  String   @map("event_type")
  eventId    String   @map("event_id")
  payload    Json
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)

  status        WebhookDeliveryStatus @default(PENDING)
  attempts      Int                   @default(0)
  nextAttemptAt DateTime?             @map("next_attempt_at") @db.Timestamptz(3)

  lastStatusCode Int?      @map("last_status_code")
  lastError      String?   @map("last_error")
  lastDurationMs Int?      @map("last_duration_ms")
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventId])
  @@index([status, nextAttemptAt])
  @@index([organizationId, createdAt])
  @@map("webhook_deliveries")
}

enum InboundEventStatus {
  /// Recebido e guardado, ainda nao aplicado.
  RECEIVED
  /// Aplicado: mudou alguma coisa no sistema.
  PROCESSED
  /// Entendido e deliberadamente sem efeito. Ex: a cobranca ja tinha desfecho.
  IGNORED
  /// Nao foi possivel aplicar. Fica para inspecao e reprocessamento.
  FAILED
}

/// Um evento que o provedor nos mandou.
///
/// A linha e gravada em transacao propria, **antes** de qualquer efeito, e o
/// indice unico sobre (provedor, id externo) e o que recusa a reentrega. Ver
/// ADR-0016: nem o indice sozinho nem a checagem de estado sozinha bastam, e
/// por isso os dois existem.
model InboundWebhookEvent {
  id       String @id @default(uuid(7)) @db.Uuid
  provider String

  /// O identificador que o provedor deu ao evento. E dele, nao nosso.
  externalId String @map("external_id")
  eventType  String @map("event_type")

  /// O corpo exato como chegou, em texto e nao em Json: a assinatura cobre os
  /// bytes recebidos, e reserializar mudaria a ordem das chaves e quebraria
  /// qualquer reverificacao posterior.
  body String

  status InboundEventStatus @default(RECEIVED)

  /// Descoberta durante o processamento, e nula ate la: o provedor identifica a
  /// cobranca pela chave que nos demos a ele, e nao pela nossa organizacao.
  organizationId String? @map("organization_id") @db.Uuid

  /// O que o processamento concluiu, em uma linha, para inspecao.
  note String?

  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)

  @@unique([provider, externalId])
  @@index([status, receivedAt])
  @@map("inbound_webhook_events")
}
