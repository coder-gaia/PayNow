# Copie para .env e ajuste. O .env nunca entra no repositorio.
# Em CI e producao os segredos vem do Doppler, nao deste arquivo.

# ---------- aplicacao ----------
NODE_ENV=development
PORT=3333
LOG_LEVEL=debug

# ---------- banco ----------
# Os valores abaixo casam com o docker-compose.yml deste repositorio.
DATABASE_URL=postgresql://paynow:paynow@localhost:5433/paynow?schema=public

# ---------- fila e cache ----------
REDIS_URL=redis://localhost:6379

# ---------- worker ----------
# Ver ADR-0012: em producao o worker roda no mesmo processo da API.
# Em desenvolvimento vale deixar ligado para exercitar o caminho completo.
WORKER_ENABLED=true

# ---------- email ----------
# O docker-compose sobe um Mailpit local: interface em http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=nao-responda@paynow.local
